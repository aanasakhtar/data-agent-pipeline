# Copy this file to .env and fill in real values. Never commit .env.

# --- Neon (synthetic "customer source" Postgres) ---
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# --- Snowflake (warehouse) ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=DBT_ROLE
SNOWFLAKE_WAREHOUSE=DBT_WH
SNOWFLAKE_DATABASE=CUSTOMER_PLATFORM
SNOWFLAKE_SCHEMA_DEV=DEV
SNOWFLAKE_SCHEMA_CI=CI

# --- Airbyte Cloud (only needed if scripting syncs via API later) ---
AIRBYTE_CLOUD_API_TOKEN=
AIRBYTE_CONNECTION_ID=
